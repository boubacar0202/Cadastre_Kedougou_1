<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Fichiers réels (images, css, js) servis depuis public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^ public%{REQUEST_URI} [END]

    # Toutes les autres URLs passent par Laravel
    RewriteRule ^ public/index.php [END]
</IfModule>
